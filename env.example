# Copiez ce fichier en .env (non versionne). Valeurs de DEMONSTRATION uniquement : a changer hors POC.
# `make secrets` en fait le Secret Kubernetes `pme-secrets` ; `make dev-*` s'en sert pour le developpement local.

# PostgreSQL (une instance, trois bases : pme, moderation, keycloak)
POSTGRES_USER=pme
POSTGRES_PASSWORD=pme-poc-password

# NATS
NATS_USER=pme
NATS_PASSWORD=pme-poc-password

# Console d'administration Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-poc-password

# Grafana (compte administrateur)
GRAFANA_ADMIN=pme
GRAFANA_ADMIN_PASSWORD=pme-poc-password
