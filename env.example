# Copiez ce fichier en .env (non versionne). Valeurs de DEMONSTRATION uniquement : a changer hors POC.
# `make secrets` en fait le Secret Kubernetes `pme-secrets` ; `make dev-*` s'en sert pour le developpement local.

# PostgreSQL : une instance, quatre bases (pme, moderation, keycloak, grafana). Ce compte est celui de l'administration
# (Adminer, psql) ; chaque service a son propre compte, voir plus bas.
POSTGRES_USER=pme
POSTGRES_PASSWORD=pme

# NATS
NATS_USER=pme
NATS_PASSWORD=pme

# RabbitMQ (broker alternatif a NATS, branche de demonstration)
RABBITMQ_USER=pme
RABBITMQ_PASSWORD=pme

# Console d'administration Keycloak
KEYCLOAK_ADMIN=pme
KEYCLOAK_ADMIN_PASSWORD=pme

# Grafana (compte administrateur)
GRAFANA_ADMIN=pme
GRAFANA_ADMIN_PASSWORD=pme

# Garage (stockage objet des photos, compatible S3)
# Ces quatre valeurs sont GENEREES par `make seal` (cible garage-secrets) si elles manquent ou valent
# CHANGE_ME : il n'y a rien a remplir ici. Une valeur deja presente n'est jamais modifiee, et .env survit
# a un `minikube delete` : les memes valeurs servent au cluster suivant.
# GARAGE_ACCESS_KEY et GARAGE_SECRET_KEY sont la cle d'acces de l'API : la meme valeur est importee
# dans Garage par `make garage-init` et lue par l'API (k8s/08-api.yaml). Format : identifiant GK + 24
# caracteres hexadecimaux, secret de 64 caracteres hexadecimaux (pour les generer a la main :
# echo "GK$(openssl rand -hex 12)" puis openssl rand -hex 32).
GARAGE_ACCESS_KEY=CHANGE_ME
GARAGE_SECRET_KEY=CHANGE_ME
# Secret partage entre les processus Garage (un seul exemplaire ici, mais il est exige) et jeton de
# son API d'administration : ni l'un ni l'autre ne protege une donnee de membre.
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME

# Comptes PostgreSQL des services (pme_api, pme_moderation, pme_keycloak, pme_grafana) : un par base, limite a elle.
# Laisser CHANGE_ME : `make seal` genere ces mots de passe (ils ne sont jamais modifies ensuite).
DB_API_PASSWORD=CHANGE_ME
DB_MODERATION_PASSWORD=CHANGE_ME
DB_KEYCLOAK_PASSWORD=CHANGE_ME
DB_GRAFANA_PASSWORD=CHANGE_ME
