# Copiez ce fichier en .env (non versionne). Valeurs de DEMONSTRATION uniquement : a changer hors POC.
# `make secrets` en fait le Secret Kubernetes `pme-secrets` ; `make dev-*` s'en sert pour le developpement local.

# PostgreSQL (une instance, trois bases : pme, moderation, keycloak)
POSTGRES_USER=pme
POSTGRES_PASSWORD=CHANGE_ME

# NATS
NATS_USER=pme
NATS_PASSWORD=CHANGE_ME

# Console d'administration Keycloak
KEYCLOAK_ADMIN=pme
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Grafana (compte administrateur)
GRAFANA_ADMIN=pme
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Garage (stockage objet des photos, compatible S3)
# GARAGE_ACCESS_KEY et GARAGE_SECRET_KEY sont la cle d'acces de l'API : la meme valeur est importee
# dans Garage par `make garage-init` et lue par l'API (k8s/04-api.yaml). Le format est celui d'AWS :
# un identifiant (celui de Garage commence par GK) et un secret de 64 caracteres hexadecimaux :
#   GARAGE_ACCESS_KEY : GK suivi de 24 caracteres hexadecimaux  -> echo "GK$(openssl rand -hex 12)"
#   les trois autres valeurs                                    -> openssl rand -hex 32
GARAGE_ACCESS_KEY=CHANGE_ME
GARAGE_SECRET_KEY=CHANGE_ME
# Secret partage entre les processus Garage (un seul exemplaire ici, mais il est exige) et jeton de
# son API d'administration : ni l'un ni l'autre ne protege une donnee de membre.
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
