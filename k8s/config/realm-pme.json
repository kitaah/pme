{
  "realm": "pme",
  "displayName": "La Petite Maison de l'Épouvante",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 900,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "membre",
        "description": "Membre de la communauté : peut proposer des annonces de troc"
      },
      {
        "name": "moderateur",
        "description": "Modérateur : consulte la file de modération"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pme-web",
      "name": "Frontend React",
      "description": "Application web (client public, Authorization Code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://pme.localhost",
      "redirectUris": [
        "http://pme.localhost/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://pme.localhost",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://pme.localhost/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "pme-cli",
      "name": "Client de test en ligne de commande",
      "description": "Uniquement pour `make smoke` et `make token` : mot de passe direct (ROPC). A supprimer en production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "membre",
      "enabled": true,
      "email": "membre@petitemaisonepouvante.local",
      "emailVerified": true,
      "firstName": "Morgane",
      "lastName": "Membre",
      "credentials": [
        {
          "type": "password",
          "value": "membre",
          "temporary": false
        }
      ],
      "realmRoles": [
        "membre"
      ]
    },
    {
      "username": "moderateur",
      "enabled": true,
      "email": "moderateur@petitemaisonepouvante.local",
      "emailVerified": true,
      "firstName": "Maxime",
      "lastName": "Moderateur",
      "credentials": [
        {
          "type": "password",
          "value": "moderateur",
          "temporary": false
        }
      ],
      "realmRoles": [
        "membre",
        "moderateur"
      ]
    }
  ]
}
