// Configuration d'Alloy (ConfigMap `alloy-config`, generee par kustomize :
// modifier ce fichier redemarre Alloy automatiquement).
// Chaine : decouverte des pods du namespace -> etiquettes -> lecture des logs -> filtrage -> envoi a Loki.

// 1. Decouverte : tous les pods du namespace pme (un seul namespace, voir le Role dans k8s/13-alloy.yaml).
discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["pme"]
  }
}

// 2. Etiquettes : peu de valeurs differentes, pour que Loki reste leger. `app` reprend le label `app` des
// Deployments (pme-api, keycloak...), comme les jobs de Prometheus. `pod` permet de separer les replicas
// de l'autoscaling.
discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

// 3. Lecture : les logs sont lus par l'API Kubernetes (comme `kubectl logs`), sans acces aux fichiers du noeud.
loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.filtrage.receiver]
}

// 4. Filtrage : ecarte le bruit avant l'envoi, pour ne stocker que ce qui sert. Une regle = un cas, a documenter ici.
//   - Adminer (serveur PHP integre) journalise chaque requete, y compris les sondes de Kubernetes (readiness et
//     liveness, toutes les 10 a 20 s). Elles viennent du noeud, 10.244.0.1 (passerelle du reseau des pods de Minikube).
//     Les vraies requetes arrivent de l'ingress, d'une autre adresse : elles restent journalisees.
//     Les sondes du front sont deja ecartees a la source (access_log off, frontend/nginx.conf).
loki.process "filtrage" {
  forward_to = [loki.write.loki.receiver]

  stage.match {
    selector = `{app="adminer"}`
    stage.drop {
      expression = `\[::ffff:10\.244\.0\.1\]:\d+ `
    }
  }
}

// 5. Envoi : au Service `loki`, par son nom dans le cluster.
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
