{
  "name": "pme-api",
  "version": "0.1.0",
  "description": "API du POC La Petite Maison de l'Epouvante (NestJS) - depot d'annonces de troc",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:all": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit --coverage"
  },
  "dependencies": {
    "@nestjs/common": "~12.4.0",
    "@nestjs/core": "~12.4.0",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "~12.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "jwks-rsa": "^3.2.2",
    "nats": "^2.29.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "~12.4.0",
    "@testcontainers/nats": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "^30.5.2",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
